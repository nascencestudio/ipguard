{
  "name": "@nascencestudio/ipguard",
  "version": "0.1.0",
  "description": "IP protection for StudioCMS sites: review lists (whitelist, flagged, blacklist, banned), rate limiting, AbuseIPDB reputation checks and site-wide bans",
  "license": "MIT",
  "author": "Nascence Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nascencestudio/ipguard.git"
  },
  "homepage": "https://github.com/nascencestudio/ipguard#readme",
  "bugs": {
    "url": "https://github.com/nascencestudio/ipguard/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guard": {
      "types": "./dist/runtime/guard.d.ts",
      "default": "./dist/runtime/guard.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "studiocms": "^0.6.0 || ^0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "astro": "7.3.5",
    "studiocms": "0.6.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "astro",
    "studiocms",
    "studiocms-plugin",
    "security",
    "spam",
    "abuseipdb",
    "rate-limit",
    "ip-blocking"
  ],
  "packageManager": "pnpm@12.4.2"
}
